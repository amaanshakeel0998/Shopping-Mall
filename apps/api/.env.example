# ============================================================
# Mall POS System - Environment Configuration
# Copy this file to .env and fill in all values
# ============================================================

# Server
PORT=3000
NODE_ENV=production

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=8h

# Mall Info
MALL_NAME=Grand Mall Plaza
MALL_ADDRESS=Ground Floor, Main Street, City
MALL_PHONE=0300-1234567
MALL_EMAIL=info@grandmall.com
CURRENCY_SYMBOL=Rs.
TAX_LABEL=GST
TIMEZONE=Asia/Karachi

# Database
DB_PATH=./data/mallpos.db

# File Storage
INVOICE_STORAGE_PATH=./data/invoices
RECEIPT_STORAGE_PATH=./data/receipts

# Session
SESSION_INACTIVITY_MINUTES=30

# Email (optional - for PDF invoice delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@grandmall.com
